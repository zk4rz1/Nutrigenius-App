<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sfondo"
    android:orientation="vertical"
    android:padding="6dp">
    <LinearLayout android:id="@+id/acqua_totale" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:contentDescription="Apri il dettaglio dell'acqua">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/ic_widget_goccia" android:importantForAccessibility="no" />
        <TextView android:id="@+id/acqua_testo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="3dp" android:textColor="#1E293B" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ProgressBar android:id="@+id/acqua_livello" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="2dp" android:indeterminate="false" android:max="100" android:progress="0" android:progressDrawable="@drawable/widget_barra" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="5dp" android:orientation="horizontal">
        <ImageView android:id="@+id/marca_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/marca_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scaleType="centerInside" android:src="@drawable/ic_widget_marca" android:visibility="invisible" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="3dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/due_aggiungi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="@drawable/widget_pulsante" android:gravity="center" android:orientation="horizontal" android:contentDescription="Aggiungi">
            <FrameLayout android:layout_width="27dp" android:layout_height="17dp">
            <ImageView android:id="@+id/due_icona" android:src="@drawable/ic_widget_bicchiere" android:layout_width="17dp" android:layout_height="17dp" android:layout_gravity="center" android:importantForAccessibility="no" />
            <TextView android:id="@+id/due_badge" android:layout_width="wrap_content" android:layout_height="14dp" android:minWidth="14dp" android:layout_gravity="top|end" android:background="@drawable/widget_badge" android:gravity="center" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="#FFFFFF" android:textSize="9sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        </FrameLayout>
            <TextView android:id="@+id/due_ml" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="—" android:textColor="#1E293B" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/due_scegli" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/widget_pulsante" android:gravity="center" android:orientation="horizontal" android:contentDescription="Seleziona la quantità">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_widget_freccia" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
