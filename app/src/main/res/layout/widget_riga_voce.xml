<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/riga_radice"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="3dp"
    android:paddingEnd="8dp"
    android:paddingBottom="3dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/riga_nome" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="#1E293B" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/riga_quantita" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#475569" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <TextView android:id="@+id/riga_ingredienti" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#94A3B8" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
</LinearLayout>
